{
  "name": "claude-accounts-pool",
  "version": "0.4.0",
  "description": "OpenCode TUI plugin for pooling Claude (Pro/Max) and ChatGPT accounts. Runs in local mode (single machine), or cloud-master / cloud-worker mode where one central host is the sole token refresher and leases short-lived access tokens to worker machines.",
  "type": "module",
  "license": "MIT",
  "author": "vince.dai",
  "homepage": "https://github.com/Daiwenxi798673133/claude-accounts-pool#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Daiwenxi798673133/claude-accounts-pool.git"
  },
  "bugs": {
    "url": "https://github.com/Daiwenxi798673133/claude-accounts-pool/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "claude",
    "anthropic",
    "usage",
    "quota",
    "multi-account",
    "tui",
    "openai",
    "chatgpt",
    "codex",
    "cloud",
    "pool",
    "account-pool",
    "lease"
  ],
  "exports": {
    ".": {
      "import": "./dist/tui.js"
    },
    "./tui": {
      "import": "./dist/tui.js"
    }
  },
  "files": [
    "dist",
    "tui.tsx",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "opencode": ">=1.3.13",
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsc --noEmit && bun run build"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.17.4",
    "@opentui/solid": "^0.4.1",
    "solid-js": "^1.9.13"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.3",
    "typescript": "^5.9.3"
  }
}
